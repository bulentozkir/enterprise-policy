{
  "name": "global-r06-r06-subscription-classification-tag",
  "properties": {
    "displayName": "Require tag name and a value from a set on Subscriptions",
    "description": "Require tag name where value is from a set (parameter allowedTagValues) on Subscriptions.",
    "mode": "All",
    "metadata": {
      "category": "Tags",
      "source": "https://raw.githubusercontent.com/Azure/Community-Policy/master/policyDefinitions/Tags/required-tag-and-value-set-on-subscriptions/azurepolicy.json",
      "sourcePolicyId": "ce5c3d48-6096-4ed7-b2ae-a1b730f5f49d",
      "catalogRow": "R06",
      "packageSet": "Global"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Start in audit mode. Only effects supported by the source definition are available."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "tagName": {
        "type": "String",
        "metadata": {
          "displayName": "Tag Name",
          "description": "Name of the tag, such as 'CostCenter'"
        }
      },
      "allowedTagValues": {
        "type": "Array",
        "metadata": {
          "displayName": "Allowable values for tag",
          "description": "List of allowed values for this tag."
        }
      },
      "evaluationScope": {
        "type": "Object",
        "metadata": {
          "displayName": "Explicit conditional resource applicability",
          "description": "Required applicability decision: includedResourceIdPatterns must contain at least one approved ARM resource-ID pattern; excludedResourceIdPatterns must be supplied and may be empty. Each pattern is exact or uses at most one '*' wildcard, following Policy like semantics. No resource IDs or default scope are assumed. Patterns filter resources already within the assignment scope and never expand that scope."
        },
        "schema": {
          "type": "object",
          "properties": {
            "includedResourceIdPatterns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^*]*(\\*[^*]*)?$"
              }
            },
            "excludedResourceIdPatterns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^*]*(\\*[^*]*)?$"
              }
            }
          },
          "required": [
            "includedResourceIdPatterns",
            "excludedResourceIdPatterns"
          ],
          "additionalProperties": false
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "count": {
              "value": "[parameters('evaluationScope').includedResourceIdPatterns]",
              "name": "evaluationScopeIncludedPattern",
              "where": {
                "field": "id",
                "like": "[current('evaluationScopeIncludedPattern')]"
              }
            },
            "greater": 0
          },
          {
            "count": {
              "value": "[parameters('evaluationScope').excludedResourceIdPatterns]",
              "name": "evaluationScopeExcludedPattern",
              "where": {
                "field": "id",
                "like": "[current('evaluationScopeExcludedPattern')]"
              }
            },
            "equals": 0
          },
          {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.Resources/subscriptions"
              },
              {
                "anyOf": [
                  {
                    "field": "[concat('tags[', parameters('tagName'), ']')]",
                    "exists": "false"
                  },
                  {
                    "field": "[concat('tags[', parameters('tagName'), ']')]",
                    "notIn": "[parameters('allowedTagValues')]"
                  }
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    },
    "policyType": "Custom"
  }
}
