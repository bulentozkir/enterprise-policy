{
  "name": "global-r16-arm-key-rotation-profile",
  "properties": {
    "displayName": "Audit ARM-managed Key Vault key rotation action and approved trigger",
    "description": "Audit ARM-managed Key Vault key rotation action and approved trigger. Read-only custom check with required approved applicability inputs.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Key Vault",
      "source": "https://policyalias.mats.codes/Microsoft.KeyVault/vaults-keys/",
      "catalogRow": "R16",
      "packageSet": "Global"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Effect"
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "profile": {
        "type": "Object",
        "metadata": {
          "displayName": "Required reviewed target resource IDs and control profile; no inferred eligibility.",
          "description": "Required reviewed target resource IDs and control profile; no inferred eligibility."
        },
        "schema": {
          "type": "object",
          "required": [
            "resourceIds",
            "approvedRotationIntervals"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "approvedRotationIntervals": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.KeyVault/vaults/keys"
              },
              {
                "field": "id",
                "in": "[parameters('profile').resourceIds]"
              }
            ]
          },
          {
            "count": {
              "field": "Microsoft.KeyVault/vaults/keys/rotationPolicy.lifetimeActions[*]",
              "where": {
                "allOf": [
                  {
                    "field": "Microsoft.KeyVault/vaults/keys/rotationPolicy.lifetimeActions[*].action.type",
                    "equals": "Rotate"
                  },
                  {
                    "field": "Microsoft.KeyVault/vaults/keys/rotationPolicy.lifetimeActions[*].trigger.timeAfterCreate",
                    "in": "[parameters('profile').approvedRotationIntervals]"
                  }
                ]
              }
            },
            "equals": 0
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
