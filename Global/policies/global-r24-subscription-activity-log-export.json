{
  "name": "global-r24-subscription-activity-log-export",
  "properties": {
    "displayName": "Audit subscription all Activity Log categories sent to Log Analytics",
    "description": "Audits the listed subscriptions whose Activity Log is not sent to the approved Log Analytics workspace with every category enabled. A subscription diagnostic setting is compliant when it targets the approved workspace and enables the allLogs category group or all eight Activity Log categories. Read-only: nothing is created or changed.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Monitoring",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/Monitoring/DataConnectorsAzureActivity.json",
      "catalogRow": "R24",
      "packageSet": "Global"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "AuditIfNotExists (default) reports non-compliant resources; Disabled turns the policy off. No deployment or modification effect is available."
        },
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "AuditIfNotExists"
      },
      "profile": {
        "type": "Object",
        "metadata": {
          "displayName": "Approved subscriptions and Log Analytics workspace",
          "description": "Required object with the properties: resourceIds (subscription resource IDs (/subscriptions/<id>); resources that are not listed are never evaluated); workspaceId (resource ID of the approved Log Analytics workspace)."
        },
        "schema": {
          "type": "object",
          "required": [
            "resourceIds",
            "workspaceId"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "workspaceId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Resources/subscriptions"
          },
          {
            "field": "id",
            "in": "[parameters('profile').resourceIds]"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.Insights/diagnosticSettings",
          "existenceCondition": {
            "allOf": [
              {
                "field": "Microsoft.Insights/diagnosticSettings/workspaceId",
                "equals": "[parameters('profile').workspaceId]"
              },
              {
                "anyOf": [
                  {
                    "count": {
                      "field": "Microsoft.Insights/diagnosticSettings/logs[*]",
                      "where": {
                        "allOf": [
                          {
                            "field": "Microsoft.Insights/diagnosticSettings/logs[*].enabled",
                            "equals": true
                          },
                          {
                            "field": "Microsoft.Insights/diagnosticSettings/logs[*].categoryGroup",
                            "equals": "allLogs"
                          }
                        ]
                      }
                    },
                    "greater": 0
                  },
                  {
                    "count": {
                      "field": "Microsoft.Insights/diagnosticSettings/logs[*]",
                      "where": {
                        "allOf": [
                          {
                            "field": "Microsoft.Insights/diagnosticSettings/logs[*].enabled",
                            "equals": true
                          },
                          {
                            "field": "Microsoft.Insights/diagnosticSettings/logs[*].category",
                            "in": [
                              "Administrative",
                              "Security",
                              "ServiceHealth",
                              "Alert",
                              "Recommendation",
                              "Policy",
                              "Autoscale",
                              "ResourceHealth"
                            ]
                          }
                        ]
                      }
                    },
                    "equals": 8
                  }
                ]
              }
            ]
          },
          "existenceScope": "Subscription"
        }
      }
    }
  }
}
