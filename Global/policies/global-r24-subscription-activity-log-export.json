{
  "name": "global-r24-subscription-activity-log-export",
  "properties": {
    "displayName": "Check subscription Activity Log categories and destination",
    "description": "Check subscription Activity Log categories and destination. Read-only custom check with required approved applicability inputs.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Monitoring",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/Monitoring/DataConnectorsAzureActivity.json",
      "catalogRow": "R24",
      "packageSet": "Global"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Effect"
        },
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "AuditIfNotExists"
      },
      "profile": {
        "type": "Object",
        "metadata": {
          "displayName": "Required reviewed target resource IDs and control profile; no inferred eligibility.",
          "description": "Required reviewed target resource IDs and control profile; no inferred eligibility."
        },
        "schema": {
          "type": "object",
          "required": [
            "resourceIds",
            "workspaceId",
            "requiredCategories"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "workspaceId": {
              "type": "string",
              "minLength": 1
            },
            "requiredCategories": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Resources/subscriptions"
          },
          {
            "field": "id",
            "in": "[parameters('profile').resourceIds]"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.Insights/diagnosticSettings",
          "existenceCondition": {
            "allOf": [
              {
                "field": "Microsoft.Insights/diagnosticSettings/workspaceId",
                "equals": "[parameters('profile').workspaceId]"
              },
              {
                "count": {
                  "value": "[parameters('profile').requiredCategories]",
                  "name": "requiredCategory",
                  "where": {
                    "count": {
                      "field": "Microsoft.Insights/diagnosticSettings/logs[*]",
                      "where": {
                        "allOf": [
                          {
                            "field": "Microsoft.Insights/diagnosticSettings/logs[*].enabled",
                            "equals": true
                          },
                          {
                            "field": "Microsoft.Insights/diagnosticSettings/logs[*].category",
                            "equals": "[current('requiredCategory')]"
                          }
                        ]
                      }
                    },
                    "greater": 0
                  }
                },
                "equals": "[length(parameters('profile').requiredCategories)]"
              }
            ]
          },
          "existenceScope": "Subscription"
        }
      }
    }
  }
}
