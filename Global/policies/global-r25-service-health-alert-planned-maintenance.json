{
  "name": "global-r25-service-health-alert-planned-maintenance",
  "properties": {
    "displayName": "Audit subscription Service Health alerts are enabled for Planned maintenance",
    "description": "Audits the listed subscriptions that have no enabled Service Health alert for ['Maintenance']. The alert must be scoped to the subscription, use the ServiceHealth category, cover the event type (listed explicitly or because the alert has no event-type filter) and notify every required action group. Service and region filters are not evaluated. Read-only: nothing is created or changed.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Monitoring",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/Monitoring/ServiceHealthSubscriptionLevelAlertRules_DINE.json",
      "catalogRow": "R25",
      "packageSet": "Global"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "AuditIfNotExists (default) reports non-compliant resources; Disabled turns the policy off. No deployment or modification effect is available."
        },
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "AuditIfNotExists"
      },
      "profile": {
        "type": "Object",
        "metadata": {
          "displayName": "Approved subscriptions and action groups",
          "description": "Required object with the properties: resourceIds (subscription resource IDs (/subscriptions/<id>); resources that are not listed are never evaluated); actionGroupIds (resource IDs of the action groups the alert must notify; all are required)."
        },
        "schema": {
          "type": "object",
          "required": [
            "resourceIds",
            "actionGroupIds"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "actionGroupIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Resources/subscriptions"
          },
          {
            "field": "id",
            "in": "[parameters('profile').resourceIds]"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.Insights/ActivityLogAlerts",
          "existenceCondition": {
            "allOf": [
              {
                "field": "Microsoft.Insights/ActivityLogAlerts/enabled",
                "equals": true
              },
              {
                "field": "Microsoft.Insights/ActivityLogAlerts/scopes",
                "contains": "[field('id')]"
              },
              {
                "count": {
                  "field": "Microsoft.Insights/ActivityLogAlerts/condition.allOf[*]",
                  "where": {
                    "allOf": [
                      {
                        "field": "Microsoft.Insights/ActivityLogAlerts/condition.allOf[*].field",
                        "equals": "category"
                      },
                      {
                        "field": "Microsoft.Insights/ActivityLogAlerts/condition.allOf[*].equals",
                        "equals": "ServiceHealth"
                      }
                    ]
                  }
                },
                "greater": 0
              },
              {
                "anyOf": [
                  {
                    "count": {
                      "field": "Microsoft.Insights/ActivityLogAlerts/condition.allOf[*]",
                      "where": {
                        "allOf": [
                          {
                            "field": "Microsoft.Insights/ActivityLogAlerts/condition.allOf[*].field",
                            "equals": "properties.incidentType"
                          },
                          {
                            "field": "Microsoft.Insights/ActivityLogAlerts/condition.allOf[*].equals",
                            "equals": "Maintenance"
                          }
                        ]
                      }
                    },
                    "greater": 0
                  },
                  {
                    "count": {
                      "field": "Microsoft.Insights/ActivityLogAlerts/condition.allOf[*].anyOf[*]",
                      "where": {
                        "allOf": [
                          {
                            "field": "Microsoft.Insights/ActivityLogAlerts/condition.allOf[*].anyOf[*].field",
                            "equals": "properties.incidentType"
                          },
                          {
                            "field": "Microsoft.Insights/ActivityLogAlerts/condition.allOf[*].anyOf[*].equals",
                            "equals": "Maintenance"
                          }
                        ]
                      }
                    },
                    "greater": 0
                  },
                  {
                    "allOf": [
                      {
                        "count": {
                          "field": "Microsoft.Insights/ActivityLogAlerts/condition.allOf[*]",
                          "where": {
                            "field": "Microsoft.Insights/ActivityLogAlerts/condition.allOf[*].field",
                            "equals": "properties.incidentType"
                          }
                        },
                        "equals": 0
                      },
                      {
                        "count": {
                          "field": "Microsoft.Insights/ActivityLogAlerts/condition.allOf[*].anyOf[*]",
                          "where": {
                            "field": "Microsoft.Insights/ActivityLogAlerts/condition.allOf[*].anyOf[*].field",
                            "equals": "properties.incidentType"
                          }
                        },
                        "equals": 0
                      }
                    ]
                  }
                ]
              },
              {
                "count": {
                  "value": "[parameters('profile').actionGroupIds]",
                  "name": "requiredGroup",
                  "where": {
                    "count": {
                      "field": "Microsoft.Insights/ActivityLogAlerts/actions.actionGroups[*]",
                      "where": {
                        "field": "Microsoft.Insights/ActivityLogAlerts/actions.actionGroups[*].actionGroupId",
                        "equals": "[current('requiredGroup')]"
                      }
                    },
                    "greater": 0
                  }
                },
                "equals": "[length(parameters('profile').actionGroupIds)]"
              }
            ]
          },
          "existenceScope": "Subscription"
        }
      }
    }
  }
}
