{
  "name": "global-r26-r26-vmss-approved-license",
  "properties": {
    "displayName": "Audit Azure Hybrid Benefit for Windows Server on virtual machine scale sets",
    "description": "Audits the listed virtual machine scale sets whose model does not have Azure Hybrid Benefit for Windows Server enabled (virtualMachineProfile.licenseType Windows_Server). Only scale sets in the approved resource ID list are evaluated; eligibility is never inferred. Read-only: nothing is created or changed.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Licensing",
      "source": "https://learn.microsoft.com/azure/virtual-machines/windows/hybrid-use-benefit-licensing",
      "catalogRow": "R26",
      "packageSet": "Global"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Audit (default) reports non-compliant resources. Deny can be selected later to block non-compliant changes; Disabled turns the policy off."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "profile": {
        "type": "Object",
        "metadata": {
          "displayName": "Approved virtual machine scale sets",
          "description": "Required object with the properties: resourceIds (virtual machine scale set resource IDs; resources that are not listed are never evaluated)."
        },
        "schema": {
          "type": "object",
          "required": [
            "resourceIds"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.Compute/virtualMachineScaleSets"
              },
              {
                "field": "id",
                "in": "[parameters('profile').resourceIds]"
              }
            ]
          },
          {
            "field": "Microsoft.Compute/virtualMachineScaleSets/virtualMachineProfile.licenseType",
            "notEquals": "Windows_Server"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
