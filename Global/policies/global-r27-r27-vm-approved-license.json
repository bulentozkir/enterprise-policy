{
  "name": "global-r27-r27-vm-approved-license",
  "properties": {
    "displayName": "Audit approved Windows client BYOL licensing on VM resources",
    "description": "Audit approved Windows client BYOL licensing on VM resources. Read-only custom check with required approved applicability inputs.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Licensing",
      "source": "https://learn.microsoft.com/azure/virtual-machines/windows/windows-desktop-multitenant-hosting-deployment",
      "catalogRow": "R27",
      "packageSet": "Global"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Effect"
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "profile": {
        "type": "Object",
        "metadata": {
          "displayName": "Required reviewed target resource IDs and control profile; no inferred eligibility.",
          "description": "Required reviewed target resource IDs and control profile; no inferred eligibility."
        },
        "schema": {
          "type": "object",
          "required": [
            "resourceIds"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.Compute/virtualMachines"
              },
              {
                "field": "id",
                "in": "[parameters('profile').resourceIds]"
              }
            ]
          },
          {
            "field": "Microsoft.Compute/virtualMachines/licenseType",
            "notEquals": "Windows_Client"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
