{
  "name": "global-r28-sql-vm-ahb",
  "properties": {
    "displayName": "Audit Azure Hybrid Benefit for SQL Server on Azure VMs",
    "description": "Audits the listed SQL Server on Azure virtual machines (SQL virtual machine resources) whose SQL Server license type is not Azure Hybrid Benefit (AHUB). Only resources in the approved resource ID list are evaluated; eligibility is never inferred. Read-only: nothing is created or changed.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Licensing",
      "source": "https://learn.microsoft.com/azure/azure-sql/virtual-machines/windows/licensing-model-azure-hybrid-benefit-ahb-change",
      "catalogRow": "R28",
      "packageSet": "Global"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Audit (default) reports non-compliant resources. Deny can be selected later to block non-compliant changes; Disabled turns the policy off."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "profile": {
        "type": "Object",
        "metadata": {
          "displayName": "Approved SQL virtual machines",
          "description": "Required object with the properties: resourceIds (SQL virtual machine resource IDs; resources that are not listed are never evaluated)."
        },
        "schema": {
          "type": "object",
          "required": [
            "resourceIds"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.SqlVirtualMachine/sqlVirtualMachines"
              },
              {
                "field": "id",
                "in": "[parameters('profile').resourceIds]"
              }
            ]
          },
          {
            "field": "Microsoft.SqlVirtualMachine/SqlVirtualMachines/sqlServerLicenseType",
            "notEquals": "AHUB"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
