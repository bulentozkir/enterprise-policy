{
  "name": "global-r29-sql-mi-ahb",
  "properties": {
    "displayName": "Audit Azure Hybrid Benefit for Azure SQL Managed Instance",
    "description": "Audits the listed Azure SQL Managed Instances that are not in an instance pool and do not use Azure Hybrid Benefit (licenseType BasePrice). Only instances in the approved resource ID list are evaluated; eligibility is never inferred. Read-only: nothing is created or changed.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Licensing",
      "source": "https://learn.microsoft.com/azure/azure-sql/azure-hybrid-benefit",
      "catalogRow": "R29",
      "packageSet": "Global"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Audit (default) reports non-compliant resources. Deny can be selected later to block non-compliant changes; Disabled turns the policy off."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "profile": {
        "type": "Object",
        "metadata": {
          "displayName": "Approved SQL managed instances",
          "description": "Required object with the properties: resourceIds (SQL managed instance resource IDs; resources that are not listed are never evaluated)."
        },
        "schema": {
          "type": "object",
          "required": [
            "resourceIds"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.Sql/managedInstances"
              },
              {
                "field": "id",
                "in": "[parameters('profile').resourceIds]"
              }
            ]
          },
          {
            "field": "Microsoft.Sql/managedInstances/instancePoolId",
            "exists": false
          },
          {
            "field": "Microsoft.Sql/managedInstances/licenseType",
            "notEquals": "BasePrice"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
