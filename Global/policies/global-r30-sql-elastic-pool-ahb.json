{
  "name": "global-r30-sql-elastic-pool-ahb",
  "properties": {
    "displayName": "Audit Azure Hybrid Benefit for Azure SQL Database elastic pools",
    "description": "Audits the listed Azure SQL Database elastic pools that do not use Azure Hybrid Benefit (licenseType BasePrice). Only pools in the approved resource ID list are evaluated; eligibility is never inferred. Read-only: nothing is created or changed.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Licensing",
      "source": "https://learn.microsoft.com/azure/azure-sql/azure-hybrid-benefit",
      "catalogRow": "R30",
      "packageSet": "Global"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Audit (default) reports non-compliant resources. Deny can be selected later to block non-compliant changes; Disabled turns the policy off."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "profile": {
        "type": "Object",
        "metadata": {
          "displayName": "Approved SQL elastic pools",
          "description": "Required object with the properties: resourceIds (SQL elastic pool resource IDs; resources that are not listed are never evaluated)."
        },
        "schema": {
          "type": "object",
          "required": [
            "resourceIds"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.Sql/servers/elasticPools"
              },
              {
                "field": "id",
                "in": "[parameters('profile').resourceIds]"
              }
            ]
          },
          {
            "field": "Microsoft.Sql/servers/elasticpools/licenseType",
            "notEquals": "BasePrice"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
