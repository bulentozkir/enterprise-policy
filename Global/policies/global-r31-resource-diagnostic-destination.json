{
  "name": "global-r31-resource-diagnostic-destination",
  "properties": {
    "displayName": "Check resource audit logs and approved Log Analytics destination",
    "description": "Audits the listed resources of the listed resource types that have no diagnostic setting sending the selected log category group (audit or allLogs) to the approved Log Analytics workspace. It does not prove log delivery. Read-only: nothing is created or changed.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Monitoring",
      "source": "https://github.com/Azure/Community-Policy/tree/master/policyDefinitions/Storage/audit-diagnostic-setting-for-selected-resource-types",
      "catalogRow": "R31",
      "packageSet": "Global"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "AuditIfNotExists (default) reports non-compliant resources; Disabled turns the policy off. No deployment or modification effect is available."
        },
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "AuditIfNotExists"
      },
      "profile": {
        "type": "Object",
        "metadata": {
          "displayName": "Approved resources and diagnostic destination",
          "description": "Required object with the properties: resourceIds (resource IDs; resources that are not listed are never evaluated); resourceTypes (resource types to evaluate, for example Microsoft.KeyVault/vaults); workspaceId (resource ID of the approved Log Analytics workspace); categoryGroup (log category group that must be enabled: audit or allLogs)."
        },
        "schema": {
          "type": "object",
          "required": [
            "resourceIds",
            "resourceTypes",
            "workspaceId",
            "categoryGroup"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "resourceTypes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "workspaceId": {
              "type": "string",
              "minLength": 1
            },
            "categoryGroup": {
              "type": "string",
              "enum": [
                "audit",
                "allLogs"
              ]
            }
          }
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "in": "[parameters('profile').resourceTypes]"
          },
          {
            "field": "id",
            "in": "[parameters('profile').resourceIds]"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.Insights/diagnosticSettings",
          "existenceCondition": {
            "allOf": [
              {
                "field": "Microsoft.Insights/diagnosticSettings/workspaceId",
                "equals": "[parameters('profile').workspaceId]"
              },
              {
                "count": {
                  "field": "Microsoft.Insights/diagnosticSettings/logs[*]",
                  "where": {
                    "allOf": [
                      {
                        "field": "Microsoft.Insights/diagnosticSettings/logs[*].enabled",
                        "equals": true
                      },
                      {
                        "field": "Microsoft.Insights/diagnosticSettings/logs[*].categoryGroup",
                        "equals": "[parameters('profile').categoryGroup]"
                      }
                    ]
                  }
                },
                "greater": 0
              }
            ]
          }
        }
      }
    }
  }
}
