{
  "name": "global-r31-resource-diagnostic-destination",
  "properties": {
    "displayName": "Check resource audit logs and approved Log Analytics destination",
    "description": "Check resource audit logs and approved Log Analytics destination. Read-only custom check with required approved applicability inputs.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Monitoring",
      "source": "https://github.com/Azure/Community-Policy/tree/master/policyDefinitions/Storage/audit-diagnostic-setting-for-selected-resource-types",
      "catalogRow": "R31",
      "packageSet": "Global"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Effect"
        },
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "AuditIfNotExists"
      },
      "profile": {
        "type": "Object",
        "metadata": {
          "displayName": "Required reviewed target resource IDs and control profile; no inferred eligibility.",
          "description": "Required reviewed target resource IDs and control profile; no inferred eligibility."
        },
        "schema": {
          "type": "object",
          "required": [
            "resourceIds",
            "resourceTypes",
            "workspaceId",
            "categoryGroup"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "resourceTypes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "workspaceId": {
              "type": "string",
              "minLength": 1
            },
            "categoryGroup": {
              "type": "string",
              "enum": [
                "audit",
                "allLogs"
              ]
            }
          }
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "in": "[parameters('profile').resourceTypes]"
          },
          {
            "field": "id",
            "in": "[parameters('profile').resourceIds]"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.Insights/diagnosticSettings",
          "existenceCondition": {
            "allOf": [
              {
                "field": "Microsoft.Insights/diagnosticSettings/workspaceId",
                "equals": "[parameters('profile').workspaceId]"
              },
              {
                "count": {
                  "field": "Microsoft.Insights/diagnosticSettings/logs[*]",
                  "where": {
                    "allOf": [
                      {
                        "field": "Microsoft.Insights/diagnosticSettings/logs[*].enabled",
                        "equals": true
                      },
                      {
                        "field": "Microsoft.Insights/diagnosticSettings/logs[*].categoryGroup",
                        "equals": "[parameters('profile').categoryGroup]"
                      }
                    ]
                  }
                },
                "greater": 0
              }
            ]
          }
        }
      }
    }
  }
}
