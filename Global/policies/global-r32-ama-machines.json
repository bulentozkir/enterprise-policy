{
  "name": "global-r32-ama-machines",
  "properties": {
    "displayName": "Check approved Azure Monitor Agent on machines",
    "description": "Audits the listed Azure Arc-enabled servers that do not have the approved Azure Monitor Agent extension installed with a successful provisioning state. Only servers in the approved resource ID list are evaluated. Read-only: nothing is created or changed.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Monitoring",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/Monitoring/AzureMonitor_Agent_Windows_HybridVM_DINE.json",
      "catalogRow": "R32",
      "packageSet": "Global"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "AuditIfNotExists (default) reports non-compliant resources; Disabled turns the policy off. No deployment or modification effect is available."
        },
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "AuditIfNotExists"
      },
      "profile": {
        "type": "Object",
        "metadata": {
          "displayName": "Approved Azure Arc-enabled servers and agent type",
          "description": "Required object with the properties: resourceIds (Azure Arc-enabled server resource IDs; resources that are not listed are never evaluated); agentType (approved Azure Monitor Agent extension type: AzureMonitorWindowsAgent or AzureMonitorLinuxAgent)."
        },
        "schema": {
          "type": "object",
          "required": [
            "resourceIds",
            "agentType"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "agentType": {
              "type": "string",
              "enum": [
                "AzureMonitorWindowsAgent",
                "AzureMonitorLinuxAgent"
              ]
            }
          }
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.HybridCompute/machines"
          },
          {
            "field": "id",
            "in": "[parameters('profile').resourceIds]"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.HybridCompute/machines/extensions",
          "existenceCondition": {
            "allOf": [
              {
                "field": "Microsoft.HybridCompute/machines/extensions/publisher",
                "equals": "Microsoft.Azure.Monitor"
              },
              {
                "field": "Microsoft.HybridCompute/machines/extensions/type",
                "equals": "[parameters('profile').agentType]"
              },
              {
                "field": "Microsoft.HybridCompute/machines/extensions/provisioningState",
                "equals": "Succeeded"
              }
            ]
          }
        }
      }
    }
  }
}
