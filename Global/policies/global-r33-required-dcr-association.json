{
  "name": "global-r33-required-dcr-association",
  "properties": {
    "displayName": "Check machines have an association to an approved collection rule",
    "description": "Audits the listed virtual machines, virtual machine scale sets and Azure Arc-enabled servers that have no association with one of the approved data collection rules. Rule contents and agent health are not checked. Read-only: nothing is created or changed.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Monitoring",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/Monitoring/AzureMonitor_DCRA_Windows_DINE.json",
      "catalogRow": "R33",
      "packageSet": "Global"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "AuditIfNotExists (default) reports non-compliant resources; Disabled turns the policy off. No deployment or modification effect is available."
        },
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "AuditIfNotExists"
      },
      "profile": {
        "type": "Object",
        "metadata": {
          "displayName": "Approved machines and data collection rules",
          "description": "Required object with the properties: resourceIds (virtual machine, scale set and Azure Arc-enabled server resource IDs; resources that are not listed are never evaluated); approvedDcrIds (resource IDs of the approved data collection rules; an association with any one satisfies the check)."
        },
        "schema": {
          "type": "object",
          "required": [
            "resourceIds",
            "approvedDcrIds"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "approvedDcrIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "in": [
              "Microsoft.Compute/virtualMachines",
              "Microsoft.Compute/virtualMachineScaleSets",
              "Microsoft.HybridCompute/machines"
            ]
          },
          {
            "field": "id",
            "in": "[parameters('profile').resourceIds]"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.Insights/dataCollectionRuleAssociations",
          "existenceCondition": {
            "field": "Microsoft.Insights/dataCollectionRuleAssociations/dataCollectionRuleId",
            "in": "[parameters('profile').approvedDcrIds]"
          }
        }
      }
    }
  }
}
