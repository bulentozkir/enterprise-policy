{
  "name": "global-r34-defender-endpoint-integration",
  "properties": {
    "displayName": "Check the approved Defender for Endpoint subscription integration setting",
    "description": "Audits the listed subscriptions where the selected Microsoft Defender for Cloud setting for Defender for Endpoint integration (WDATP or WDATP_UNIFIED_SOLUTION) is not enabled. Read-only: nothing is created or changed.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Security Center",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/Security%20Center/MDC_MDE_WDATP_DINE.json",
      "catalogRow": "R34",
      "packageSet": "Global"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "AuditIfNotExists (default) reports non-compliant resources; Disabled turns the policy off. No deployment or modification effect is available."
        },
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "AuditIfNotExists"
      },
      "profile": {
        "type": "Object",
        "metadata": {
          "displayName": "Approved subscriptions and Defender setting",
          "description": "Required object with the properties: resourceIds (subscription resource IDs (/subscriptions/<id>); resources that are not listed are never evaluated); settingName (Microsoft Defender for Cloud setting to check: WDATP or WDATP_UNIFIED_SOLUTION)."
        },
        "schema": {
          "type": "object",
          "required": [
            "resourceIds",
            "settingName"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "settingName": {
              "type": "string",
              "enum": [
                "WDATP",
                "WDATP_UNIFIED_SOLUTION"
              ]
            }
          }
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Resources/subscriptions"
          },
          {
            "field": "id",
            "in": "[parameters('profile').resourceIds]"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.Security/settings",
          "existenceCondition": {
            "field": "Microsoft.Security/settings/DataExportSetting.enabled",
            "equals": true
          },
          "name": "[parameters('profile').settingName]",
          "existenceScope": "Subscription"
        }
      }
    }
  }
}
