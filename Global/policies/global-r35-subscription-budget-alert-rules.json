{
  "name": "global-r35-subscription-budget-alert-rules",
  "properties": {
    "displayName": "Audit subscriptions have budget alert rules defined",
    "description": "Audits subscriptions that do not have a Cost Management budget with alert rules (notifications) defined. Read-only check; it does not create budgets or alert rules.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Cost Management",
      "source": "https://raw.githubusercontent.com/Azure/Enterprise-Scale/main/src/resources/Microsoft.Authorization/policyDefinitions/Deploy-Budget.json",
      "catalogRow": "R35",
      "packageSet": "Global"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "AuditIfNotExists (default) reports non-compliant resources; Disabled turns the policy off. No deployment or modification effect is available."
        },
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "AuditIfNotExists"
      }
    },
    "policyRule": {
      "if": {
        "field": "type",
        "equals": "Microsoft.Resources/subscriptions"
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.Consumption/budgets",
          "existenceCondition": {
            "allOf": [
              {
                "field": "Microsoft.Consumption/budgets/category",
                "equals": "Cost"
              },
              {
                "field": "Microsoft.Consumption/budgets/notifications",
                "exists": true
              }
            ]
          },
          "existenceScope": "Subscription"
        }
      }
    }
  }
}
