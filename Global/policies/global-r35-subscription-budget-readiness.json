{
  "name": "global-r35-subscription-budget-readiness",
  "properties": {
    "displayName": "Check subscription budget existence, amount and period",
    "description": "Check subscription budget existence, amount and period. Read-only custom check with required approved applicability inputs.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Cost Management",
      "source": "https://raw.githubusercontent.com/Azure/Enterprise-Scale/main/src/resources/Microsoft.Authorization/policyDefinitions/Deploy-Budget.json",
      "catalogRow": "R35",
      "packageSet": "Global"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Effect"
        },
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "defaultValue": "AuditIfNotExists"
      },
      "profile": {
        "type": "Object",
        "metadata": {
          "displayName": "Required reviewed target resource IDs and control profile; no inferred eligibility.",
          "description": "Required reviewed target resource IDs and control profile; no inferred eligibility."
        },
        "schema": {
          "type": "object",
          "required": [
            "resourceIds",
            "budgetName",
            "amount",
            "timeGrain"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "budgetName": {
              "type": "string",
              "minLength": 1
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "timeGrain": {
              "type": "string",
              "enum": [
                "Monthly",
                "Quarterly",
                "Annually"
              ]
            }
          }
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Resources/subscriptions"
          },
          {
            "field": "id",
            "in": "[parameters('profile').resourceIds]"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.Consumption/budgets",
          "existenceCondition": {
            "allOf": [
              {
                "field": "Microsoft.Consumption/budgets/category",
                "equals": "Cost"
              },
              {
                "field": "Microsoft.Consumption/budgets/amount",
                "equals": "[parameters('profile').amount]"
              },
              {
                "field": "Microsoft.Consumption/budgets/timeGrain",
                "equals": "[parameters('profile').timeGrain]"
              }
            ]
          },
          "name": "[parameters('profile').budgetName]",
          "existenceScope": "Subscription"
        }
      }
    }
  }
}
