{
  "name": "global-r36-resource-parent-tag-consistency",
  "properties": {
    "displayName": "Audit resource tag consistency against a nonempty resource-group tag",
    "description": "Audits the listed resources whose value for the selected tag differs from the same tag on their resource group, or whose resource group tag is missing or empty. Read-only: nothing is created or changed.",
    "policyType": "Custom",
    "mode": "Indexed",
    "metadata": {
      "category": "Tags",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/Tags/InheritTag_Add_Modify.json",
      "catalogRow": "R36",
      "packageSet": "Global"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Audit (default) reports non-compliant resources. Deny can be selected later to block non-compliant changes; Disabled turns the policy off."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "profile": {
        "type": "Object",
        "metadata": {
          "displayName": "Approved resources",
          "description": "Required object with the properties: resourceIds (resource IDs; resources that are not listed are never evaluated)."
        },
        "schema": {
          "type": "object",
          "required": [
            "resourceIds"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "tagName": {
        "type": "String",
        "metadata": {
          "displayName": "Tag name to compare",
          "description": "Name of the tag whose value on each listed resource must match the same tag on its resource group. A missing or empty resource group tag is non-compliant."
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "notIn": [
              "Microsoft.Resources/subscriptions",
              "Microsoft.Resources/subscriptions/resourceGroups"
            ]
          },
          {
            "field": "id",
            "in": "[parameters('profile').resourceIds]"
          },
          {
            "anyOf": [
              {
                "value": "[if(contains(coalesce(resourceGroup().tags, createObject()), parameters('tagName')), resourceGroup().tags[parameters('tagName')], '')]",
                "equals": ""
              },
              {
                "field": "[concat('tags[', parameters('tagName'), ']')]",
                "notEquals": "[if(contains(coalesce(resourceGroup().tags, createObject()), parameters('tagName')), resourceGroup().tags[parameters('tagName')], '')]"
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
