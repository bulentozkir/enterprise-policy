{
  "name": "hub-h04-firewall-dns-proxy",
  "properties": {
    "displayName": "Hub Firewall Policies must explicitly enable DNS proxy",
    "description": "Audits Firewall Policies whose DNS proxy setting is missing or false. Unlike the upstream presence-only check, an explicit false value is noncompliant. Inheritance is not resolved. Enabled=true checks all matching in-scope resources; false skips the check.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Network",
      "version": "1.0.0",
      "designRow": "H04",
      "sourceVerifiedOn": "2026-11-02",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/Network/AzureFirewall_EnableDNSProxy_Audit.json",
      "catalogRow": "H04",
      "packageSet": "Hub"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "allowedValues": [
          "Audit",
          "Disabled"
        ],
        "defaultValue": "Audit",
        "metadata": {
          "displayName": "Effect",
          "description": "Read-only evaluation."
        }
      },
      "enabled": {
        "type": "String",
        "metadata": {
          "displayName": "Enable check throughout assignment scope",
          "description": "True checks every matching resource within the assignment scope; false skips the check. Use assignment exclusions or exemptions for exceptions. Select true or false; defaults to true."
        },
        "defaultValue": "true",
        "allowedValues": [
          "true",
          "false"
        ]
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "value": "[bool(parameters('enabled'))]",
            "equals": true
          },
          {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.Network/firewallPolicies"
              },
              {
                "anyOf": [
                  {
                    "field": "Microsoft.Network/firewallPolicies/dnsSettings.enableProxy",
                    "exists": "false"
                  },
                  {
                    "field": "Microsoft.Network/firewallPolicies/dnsSettings.enableProxy",
                    "notEquals": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
