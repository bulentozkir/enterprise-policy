{
  "name": "hub-h07-hub-ddos-approved-plan",
  "properties": {
    "displayName": "Selected hub VNets must enable DDoS protection with an approved plan",
    "description": "Audits selected eligible hub virtual networks unless enableDdosProtection is true and the associated DDoS plan resource ID is approved. This custom rule has no upstream mutation details.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Network",
      "version": "1.0.0",
      "designRow": "H07",
      "sourceVerifiedOn": "2026-11-02",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/Network/VirtualNetworkDdosStandard_Audit.json",
      "catalogRow": "H07",
      "packageSet": "Hub"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "allowedValues": [
          "Audit",
          "Disabled"
        ],
        "defaultValue": "Audit",
        "metadata": {
          "displayName": "Effect",
          "description": "Read-only evaluation."
        }
      },
      "profile": {
        "type": "Object",
        "metadata": {
          "displayName": "Approved DDoS targets and plans",
          "description": "Required eligible hub VNet IDs and approved DDoS Network Protection plan IDs. Neither list may be empty."
        },
        "schema": {
          "type": "object",
          "required": [
            "resourceIds",
            "approvedPlanIds"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^/subscriptions/[^/]+/resourceGroups/[^/]+/providers/[^/]+/.+$"
              }
            },
            "approvedPlanIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^/subscriptions/[^/]+/resourceGroups/[^/]+/providers/[^/]+/.+$"
              }
            }
          }
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Network/virtualNetworks"
          },
          {
            "field": "id",
            "in": "[parameters('profile')['resourceIds']]"
          },
          {
            "anyOf": [
              {
                "field": "Microsoft.Network/virtualNetworks/enableDdosProtection",
                "notEquals": true
              },
              {
                "field": "Microsoft.Network/virtualNetworks/ddosProtectionPlan.id",
                "exists": "false"
              },
              {
                "field": "Microsoft.Network/virtualNetworks/ddosProtectionPlan.id",
                "notIn": "[parameters('profile')['approvedPlanIds']]"
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
