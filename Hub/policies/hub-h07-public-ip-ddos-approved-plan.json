{
  "name": "hub-h07-public-ip-ddos-approved-plan",
  "properties": {
    "displayName": "Audit all Public IPs require approved DDoS Network Protection",
    "description": "Audits public IP addresses unless DDoS protection mode is Enabled with an approved DDoS protection plan. Protection inherited from the virtual network can optionally be accepted. Read-only; it does not enable protection or associate plans.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Network",
      "version": "1.0.0",
      "designRow": "H07",
      "sourceVerifiedOn": "2026-11-03",
      "source": "https://learn.microsoft.com/azure/ddos-protection/ddos-protection-overview",
      "catalogRow": "H07",
      "packageSet": "Hub"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "allowedValues": [
          "Audit",
          "Disabled"
        ],
        "defaultValue": "Audit",
        "metadata": {
          "displayName": "Effect",
          "description": "Read-only evaluation."
        }
      },
      "approvedPlanIds": {
        "type": "Array",
        "metadata": {
          "displayName": "Approved DDoS protection plan resource IDs",
          "description": "Required, nonempty list of approved DDoS Network Protection plan resource IDs. A public IP is approved only when ddosSettings.protectionMode is Enabled and ddosSettings.ddosProtectionPlan.id is in this list."
        },
        "schema": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/subscriptions/[^/]+/resourceGroups/[^/]+/providers/[^/]+/.+$"
          }
        }
      },
      "acceptVirtualNetworkInherited": {
        "type": "Boolean",
        "allowedValues": [
          true,
          false
        ],
        "defaultValue": false,
        "metadata": {
          "displayName": "Accept virtual-network-inherited protection",
          "description": "When true, public IPs whose protectionMode is VirtualNetworkInherited (or omitted) are not reported, because the plan association is on the virtual network and cannot be read from the public IP. The default false reports them."
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Network/publicIPAddresses"
          },
          {
            "not": {
              "anyOf": [
                {
                  "allOf": [
                    {
                      "field": "Microsoft.Network/publicIPAddresses/ddosSettings.protectionMode",
                      "equals": "Enabled"
                    },
                    {
                      "field": "Microsoft.Network/publicIPAddresses/ddosSettings.ddosProtectionPlan.id",
                      "in": "[parameters('approvedPlanIds')]"
                    }
                  ]
                },
                {
                  "allOf": [
                    {
                      "value": "[parameters('acceptVirtualNetworkInherited')]",
                      "equals": true
                    },
                    {
                      "field": "Microsoft.Network/publicIPAddresses/ddosSettings.protectionMode",
                      "notIn": [
                        "Enabled",
                        "Disabled"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
