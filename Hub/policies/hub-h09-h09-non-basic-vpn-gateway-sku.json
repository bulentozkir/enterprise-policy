{
  "name": "hub-h09-h09-non-basic-vpn-gateway-sku",
  "properties": {
    "displayName": "Azure VPN gateways should not use 'basic' SKU",
    "description": "This policy ensures that VPN gateways do not use 'basic' SKU.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Network",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/Network/VPNGateways_BasicSKU_Audit.json",
      "sourcePolicyId": "/providers/Microsoft.Authorization/policyDefinitions/e345b6c3-24bd-4c93-9bbb-7e5e49a17b78",
      "catalogRow": "H09",
      "packageSet": "Hub"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Disabled"
        ],
        "metadata": {
          "displayName": "Effect",
          "description": "Start in audit mode. Only effects supported by the source definition are available."
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Network/virtualNetworkGateways"
          },
          {
            "field": "Microsoft.Network/virtualNetworkGateways/gatewayType",
            "equals": "Vpn"
          },
          {
            "field": "Microsoft.Network/virtualNetworkGateways/sku.tier",
            "equals": "Basic"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
