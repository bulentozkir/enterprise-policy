{
  "name": "hub-h10-h10-entra-only-point-to-site-vpn-authentication",
  "properties": {
    "displayName": "VPN gateways should use only Azure Active Directory (Azure AD) authentication for point-to-site users",
    "description": "Disabling local authentication methods improves security by ensuring that VPN Gateways use only Azure Active Directory identities for authentication. Learn more about Azure AD authentication at https://docs.microsoft.com/azure/vpn-gateway/openvpn-azure-ad-tenant",
    "policyType": "Custom",
    "mode": "Indexed",
    "metadata": {
      "category": "Network",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/Network/VPN-AzureAD-audit-deny-disable-policy.json",
      "sourcePolicyId": "/providers/Microsoft.Authorization/policyDefinitions/21a6bc25-125e-4d13-b82d-2e19b7208ab7",
      "catalogRow": "H10",
      "packageSet": "Hub"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Start in audit mode. Only effects supported by the source definition are available."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "evaluationScope": {
        "type": "Object",
        "metadata": {
          "displayName": "Explicit conditional resource applicability",
          "description": "Required applicability decision: includedResourceIdPatterns must contain at least one approved ARM resource-ID pattern; excludedResourceIdPatterns must be supplied and may be empty. Each pattern is exact or uses at most one '*' wildcard, following Policy like semantics. No resource IDs or default scope are assumed. Patterns filter resources already within the assignment scope and never expand that scope."
        },
        "schema": {
          "type": "object",
          "properties": {
            "includedResourceIdPatterns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^*]*(\\*[^*]*)?$"
              }
            },
            "excludedResourceIdPatterns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^*]*(\\*[^*]*)?$"
              }
            }
          },
          "required": [
            "includedResourceIdPatterns",
            "excludedResourceIdPatterns"
          ],
          "additionalProperties": false
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "count": {
              "value": "[parameters('evaluationScope').includedResourceIdPatterns]",
              "name": "evaluationScopeIncludedPattern",
              "where": {
                "field": "id",
                "like": "[current('evaluationScopeIncludedPattern')]"
              }
            },
            "greater": 0
          },
          {
            "count": {
              "value": "[parameters('evaluationScope').excludedResourceIdPatterns]",
              "name": "evaluationScopeExcludedPattern",
              "where": {
                "field": "id",
                "like": "[current('evaluationScopeExcludedPattern')]"
              }
            },
            "equals": 0
          },
          {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.Network/virtualNetworkGateways"
              },
              {
                "field": "Microsoft.Network/virtualNetworkGateways/vpnClientConfiguration.vpnClientAddressPool.addressPrefixes",
                "exists": "true"
              },
              {
                "count": {
                  "field": "Microsoft.Network/virtualNetworkGateways/vpnClientConfiguration.vpnAuthenticationTypes[*]",
                  "where": {
                    "field": "Microsoft.Network/virtualNetworkGateways/vpnClientConfiguration.vpnAuthenticationTypes[*]",
                    "notContains": "AAD"
                  }
                },
                "greaterOrEquals": 1
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
