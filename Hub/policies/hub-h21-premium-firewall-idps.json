{
  "name": "hub-h21-premium-firewall-idps",
  "properties": {
    "displayName": "Premium Firewall Policies must explicitly enable approved IDPS mode",
    "description": "Audits Firewall Policies that are not Premium or whose explicit intrusionDetection.mode is missing, Off, or outside the accepted Alert/Deny modes. Base-policy inheritance is not resolved. Enabled=true checks all matching in-scope resources; false skips the check.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Network",
      "version": "1.0.0",
      "designRow": "H21",
      "sourceVerifiedOn": "2026-11-02",
      "source": "https://raw.githubusercontent.com/Azure/Azure-Network-Security/master/Azure%20Firewall/Policy%20-%20Azure%20Policy%20Definitions/Policy%20-%20Enable%20IDPS%20in%20Azure%20Firewall%20Premium%20Policy/EnableIDPSInAzureFirewallPremiumPolicy-Full.json",
      "catalogRow": "H21",
      "packageSet": "Hub"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "allowedValues": [
          "Audit",
          "Disabled"
        ],
        "defaultValue": "Audit",
        "metadata": {
          "displayName": "Effect",
          "description": "Read-only evaluation; the IDPS traffic mode is a separate configuration."
        }
      },
      "acceptedModes": {
        "type": "Array",
        "metadata": {
          "displayName": "Accepted modes",
          "description": "Select the explicit IDPS modes accepted as compliant. Defaults to both modes."
        },
        "allowedValues": [
          "Alert",
          "Deny"
        ],
        "defaultValue": [
          "Alert",
          "Deny"
        ]
      },
      "enabled": {
        "type": "String",
        "metadata": {
          "displayName": "Enable check throughout assignment scope",
          "description": "True checks every matching resource within the assignment scope; false skips the check. Use assignment exclusions or exemptions for exceptions. Select true or false; defaults to true."
        },
        "defaultValue": "true",
        "allowedValues": [
          "true",
          "false"
        ]
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "value": "[bool(parameters('enabled'))]",
            "equals": true
          },
          {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.Network/firewallPolicies"
              },
              {
                "anyOf": [
                  {
                    "field": "Microsoft.Network/firewallPolicies/sku.tier",
                    "notEquals": "Premium"
                  },
                  {
                    "field": "Microsoft.Network/firewallPolicies/intrusionDetection.mode",
                    "exists": "false"
                  },
                  {
                    "field": "Microsoft.Network/firewallPolicies/intrusionDetection.mode",
                    "notIn": "[parameters('acceptedModes')]"
                  }
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
