{
  "name": "hub-h21-premium-firewall-idps",
  "properties": {
    "displayName": "Selected Premium Firewall Policies must explicitly enable approved IDPS mode",
    "description": "Audits selected Firewall Policies if the policy is not Premium or its explicit intrusionDetection.mode is missing, Off, or outside the required accepted Alert/Deny modes. Uses the real intrusionDetection.mode alias, not the malformed reference rule.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Network",
      "version": "1.0.0",
      "designRow": "H21",
      "sourceVerifiedOn": "2026-11-02",
      "source": "https://raw.githubusercontent.com/Azure/Azure-Network-Security/master/Azure%20Firewall/Policy%20-%20Azure%20Policy%20Definitions/Policy%20-%20Enable%20IDPS%20in%20Azure%20Firewall%20Premium%20Policy/EnableIDPSInAzureFirewallPremiumPolicy-Full.json",
      "catalogRow": "H21",
      "packageSet": "Hub"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "allowedValues": [
          "Audit",
          "Disabled"
        ],
        "defaultValue": "Audit",
        "metadata": {
          "displayName": "Effect",
          "description": "Read-only evaluation; the IDPS traffic mode is a separate configuration."
        }
      },
      "profile": {
        "type": "Object",
        "metadata": {
          "displayName": "Approved Premium policies and IDPS modes",
          "description": "Required nonempty policy IDs and accepted IDPS modes. Accept Alert, Deny, or both according to approved inspection architecture."
        },
        "schema": {
          "type": "object",
          "required": [
            "resourceIds",
            "acceptedModes"
          ],
          "additionalProperties": false,
          "properties": {
            "resourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^/subscriptions/[^/]+/resourceGroups/[^/]+/providers/[^/]+/.+$"
              }
            },
            "acceptedModes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "Alert",
                  "Deny"
                ]
              }
            }
          }
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Network/firewallPolicies"
          },
          {
            "field": "id",
            "in": "[parameters('profile')['resourceIds']]"
          },
          {
            "anyOf": [
              {
                "field": "Microsoft.Network/firewallPolicies/sku.tier",
                "notEquals": "Premium"
              },
              {
                "field": "Microsoft.Network/firewallPolicies/intrusionDetection.mode",
                "exists": "false"
              },
              {
                "field": "Microsoft.Network/firewallPolicies/intrusionDetection.mode",
                "notIn": "[parameters('profile')['acceptedModes']]"
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
