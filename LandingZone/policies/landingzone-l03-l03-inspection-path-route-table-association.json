{
  "name": "landingzone-l03-l03-inspection-path-route-table-association",
  "properties": {
    "displayName": "Subnets should have a User Defined Route",
    "description": "Audits subnets without a User Defined Route (route table association). AzureBastionSubnet and RouteServerSubnet are excluded. Audit by default; Deny can be selected for enforcement. Enabled=true checks all matching in-scope resources; false skips the check.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Network",
      "source": "https://raw.githubusercontent.com/Azure/Enterprise-Scale/main/src/resources/Microsoft.Authorization/policyDefinitions/Deny-Subnet-Without-Udr.json",
      "sourcePolicyId": "Deny-Subnet-Without-Udr",
      "catalogRow": "L03",
      "packageSet": "LandingZone"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Start in audit mode. Only effects supported by the source definition are available."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "enabled": {
        "type": "String",
        "metadata": {
          "displayName": "Enable check throughout assignment scope",
          "description": "True checks every matching resource within the assignment scope; false skips the check. Use assignment exclusions or exemptions for exceptions. Select true or false; defaults to true."
        },
        "defaultValue": "true",
        "allowedValues": [
          "true",
          "false"
        ]
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "value": "[bool(parameters('enabled'))]",
            "equals": true
          },
          {
            "anyOf": [
              {
                "allOf": [
                  {
                    "equals": "Microsoft.Network/virtualNetworks",
                    "field": "type"
                  },
                  {
                    "count": {
                      "field": "Microsoft.Network/virtualNetworks/subnets[*]",
                      "where": {
                        "allOf": [
                          {
                            "exists": "false",
                            "field": "Microsoft.Network/virtualNetworks/subnets[*].routeTable.id"
                          },
                          {
                            "field": "Microsoft.Network/virtualNetworks/subnets[*].name",
                            "notIn": [
                              "AzureBastionSubnet",
                              "RouteServerSubnet"
                            ]
                          }
                        ]
                      }
                    },
                    "notEquals": 0
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.Network/virtualNetworks/subnets"
                  },
                  {
                    "field": "name",
                    "notIn": [
                      "AzureBastionSubnet",
                      "RouteServerSubnet"
                    ]
                  },
                  {
                    "field": "Microsoft.Network/virtualNetworks/subnets/routeTable.id",
                    "exists": "false"
                  }
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
