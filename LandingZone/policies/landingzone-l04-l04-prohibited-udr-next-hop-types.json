{
  "name": "landingzone-l04-l04-prohibited-udr-next-hop-types",
  "properties": {
    "displayName": "User Defined Routes should not use prohibited 'Next Hop Type' values",
    "description": "Audits route tables and routes whose 'Next Hop Type' is one of the selected prohibited types (default Internet and VirtualNetworkGateway). Audit by default; Deny can be selected for enforcement. Enabled=true checks all matching in-scope resources; false skips the check.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Network",
      "source": "https://raw.githubusercontent.com/Azure/Enterprise-Scale/main/src/resources/Microsoft.Authorization/policyDefinitions/Deny-UDR-With-Specific-NextHop.json",
      "sourcePolicyId": "Deny-UDR-With-Specific-NextHop",
      "catalogRow": "L04",
      "packageSet": "LandingZone"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Start in audit mode. Only effects supported by the source definition are available."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "excludedDestinations": {
        "type": "Array",
        "metadata": {
          "displayName": "Prohibited next hop types",
          "description": "Select the 'Next Hop Type' values that routes must not use. Defaults to Internet and VirtualNetworkGateway."
        },
        "defaultValue": [
          "Internet",
          "VirtualNetworkGateway"
        ],
        "allowedValues": [
          "Internet",
          "VirtualNetworkGateway",
          "VnetLocal",
          "VirtualAppliance",
          "None"
        ]
      },
      "enabled": {
        "type": "String",
        "metadata": {
          "displayName": "Enable check throughout assignment scope",
          "description": "True checks every matching resource within the assignment scope; false skips the check. Use assignment exclusions or exemptions for exceptions. Select true or false; defaults to true."
        },
        "defaultValue": "true",
        "allowedValues": [
          "true",
          "false"
        ]
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "value": "[bool(parameters('enabled'))]",
            "equals": true
          },
          {
            "anyOf": [
              {
                "allOf": [
                  {
                    "equals": "Microsoft.Network/routeTables",
                    "field": "type"
                  },
                  {
                    "count": {
                      "field": "Microsoft.Network/routeTables/routes[*]",
                      "where": {
                        "field": "Microsoft.Network/routeTables/routes[*].nextHopType",
                        "in": "[parameters('excludedDestinations')]"
                      }
                    },
                    "notEquals": 0
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.Network/routeTables/routes"
                  },
                  {
                    "field": "Microsoft.Network/routeTables/routes/nextHopType",
                    "in": "[parameters('excludedDestinations')]"
                  }
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
