{
  "name": "landingzone-l05-l05-approved-workload-peering-destinations",
  "properties": {
    "displayName": "vNet peerings should only connect to approved vNets",
    "description": "Audits virtual network peerings whose remote virtual network is not in the approved list; an empty list reports every peering. Audit by default; Deny can be selected for enforcement. Enabled=true checks all matching in-scope resources; false skips the check.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Network",
      "source": "https://raw.githubusercontent.com/Azure/Enterprise-Scale/main/src/resources/Microsoft.Authorization/policyDefinitions/Deny-VNET-Peering-To-Non-Approved-VNETs.json",
      "sourcePolicyId": "Deny-VNET-Peering-To-Non-Approved-VNETs",
      "catalogRow": "L05",
      "packageSet": "LandingZone"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Start in audit mode. Only effects supported by the source definition are available."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "allowedVnets": {
        "type": "Array",
        "metadata": {
          "displayName": "Allowed vNets to peer with",
          "description": "Select existing virtual networks approved as peering destinations. An empty selection approves no peers.",
          "strongType": "Microsoft.Network/virtualNetworks"
        },
        "defaultValue": []
      },
      "enabled": {
        "type": "String",
        "metadata": {
          "displayName": "Enable check throughout assignment scope",
          "description": "True checks every matching resource within the assignment scope; false skips the check. Use assignment exclusions or exemptions for exceptions. Select true or false; defaults to true."
        },
        "defaultValue": "true",
        "allowedValues": [
          "true",
          "false"
        ]
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "value": "[bool(parameters('enabled'))]",
            "equals": true
          },
          {
            "anyOf": [
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings"
                  },
                  {
                    "not": {
                      "field": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings/remoteVirtualNetwork.id",
                      "in": "[parameters('allowedVnets')]"
                    }
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "type",
                    "equals": "Microsoft.Network/virtualNetworks"
                  },
                  {
                    "not": {
                      "field": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings[*].remoteVirtualNetwork.id",
                      "in": "[parameters('allowedVnets')]"
                    }
                  },
                  {
                    "not": {
                      "field": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings[*].remoteVirtualNetwork.id",
                      "exists": false
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
