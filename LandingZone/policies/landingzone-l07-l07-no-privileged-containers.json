{
  "name": "landingzone-l07-l07-no-privileged-containers",
  "properties": {
    "displayName": "Kubernetes cluster should not allow privileged containers",
    "description": "Do not allow privileged containers creation in a Kubernetes cluster. This recommendation is part of CIS 5.2.1 which is intended to improve the security of your Kubernetes environments. This policy is generally available for Kubernetes Service (AKS), and preview for Azure Arc enabled Kubernetes. For more information, see https://aka.ms/kubepolicydoc. Enabled=true checks all matching in-scope resources; false skips the check.",
    "policyType": "Custom",
    "mode": "Microsoft.Kubernetes.Data",
    "metadata": {
      "category": "Kubernetes",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/Kubernetes/ContainerNoPrivilege.json",
      "sourcePolicyId": "/providers/Microsoft.Authorization/policyDefinitions/95edb821-ddaf-4404-9732-666045e056b4",
      "catalogRow": "L07",
      "packageSet": "LandingZone"
    },
    "parameters": {
      "source": {
        "type": "String",
        "metadata": {
          "displayName": "Source",
          "description": "The source k8s object for constraint evaluation. 'Original' means only evaluate against the specific GroupVersionKind specified in the policy definition. 'Generated' means only evaluate against k8s objects generated by Gatekeeper ExpansionTemplates. 'All' means evaluate against both the original object and any generated ones."
        },
        "defaultValue": "Original",
        "allowedValues": [
          "All",
          "Generated",
          "Original"
        ]
      },
      "warn": {
        "type": "String",
        "metadata": {
          "displayName": "Warn",
          "description": "Whether or not to return warnings back to the user in the kubectl cli Select true or false; defaults to true."
        },
        "defaultValue": "true",
        "allowedValues": [
          "true",
          "false"
        ]
      },
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Start in audit mode. Only effects supported by the source definition are available."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "enabled": {
        "type": "String",
        "metadata": {
          "displayName": "Enable check throughout assignment scope",
          "description": "True checks every matching resource within the assignment scope; false skips the check. Use assignment exclusions or exemptions for exceptions. Select true or false; defaults to true."
        },
        "defaultValue": "true",
        "allowedValues": [
          "true",
          "false"
        ]
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "value": "[bool(parameters('enabled'))]",
            "equals": true
          },
          {
            "field": "type",
            "in": [
              "Microsoft.Kubernetes/connectedClusters",
              "Microsoft.ContainerService/managedClusters"
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "source": "[parameters('source')]",
          "warn": "[bool(parameters('warn'))]",
          "templateInfo": {
            "sourceType": "Base64Encoded",
            "content": ""
          },
          "apiGroups": [
            ""
          ],
          "kinds": [
            "Pod"
          ],
          "excludedNamespaces": [
            "kube-system",
            "gatekeeper-system",
            "azure-arc",
            "azure-extensions-usage-system"
          ],
          "namespaces": [],
          "labelSelector": {},
          "values": {
            "excludedContainers": [],
            "excludedImages": []
          }
        }
      }
    }
  }
}
