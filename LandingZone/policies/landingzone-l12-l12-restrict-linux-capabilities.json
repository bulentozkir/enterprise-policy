{
  "name": "landingzone-l12-l12-restrict-linux-capabilities",
  "properties": {
    "displayName": "Kubernetes cluster containers should only use allowed capabilities",
    "description": "Restrict the capabilities to reduce the attack surface of containers in a Kubernetes cluster. This recommendation is part of CIS 5.2.8 and CIS 5.2.9 which are intended to improve the security of your Kubernetes environments. This policy is generally available for Kubernetes Service (AKS), and preview for Azure Arc enabled Kubernetes. For more information, see https://aka.ms/kubepolicydoc. Enabled=true checks all matching in-scope resources; false skips the check.",
    "policyType": "Custom",
    "mode": "Microsoft.Kubernetes.Data",
    "metadata": {
      "category": "Kubernetes",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/Kubernetes/ContainerAllowedCapabilities.json",
      "sourcePolicyId": "/providers/Microsoft.Authorization/policyDefinitions/c26596ff-4d70-4e6a-9a30-c2506bd2f80c",
      "catalogRow": "L12",
      "packageSet": "LandingZone"
    },
    "parameters": {
      "source": {
        "type": "String",
        "metadata": {
          "displayName": "Source",
          "description": "The source k8s object for constraint evaluation. 'Original' means only evaluate against the specific GroupVersionKind specified in the policy definition. 'Generated' means only evaluate against k8s objects generated by Gatekeeper ExpansionTemplates. 'All' means evaluate against both the original object and any generated ones."
        },
        "defaultValue": "Original",
        "allowedValues": [
          "All",
          "Generated",
          "Original"
        ]
      },
      "warn": {
        "type": "String",
        "metadata": {
          "displayName": "Warn",
          "description": "Whether or not to return warnings back to the user in the kubectl cli Select true or false; defaults to true."
        },
        "defaultValue": "true",
        "allowedValues": [
          "true",
          "false"
        ]
      },
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Start in audit mode. Only effects supported by the source definition are available."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "allowedCapabilities": {
        "type": "Array",
        "metadata": {
          "displayName": "Allowed capabilities",
          "description": "Select capability names from the supported Linux capability catalog, including ALL."
        },
        "defaultValue": [],
        "allowedValues": [
          "*",
          "ALL",
          "AUDIT_CONTROL",
          "AUDIT_READ",
          "AUDIT_WRITE",
          "BLOCK_SUSPEND",
          "BPF",
          "CHECKPOINT_RESTORE",
          "CHOWN",
          "DAC_OVERRIDE",
          "DAC_READ_SEARCH",
          "FOWNER",
          "FSETID",
          "IPC_LOCK",
          "IPC_OWNER",
          "KILL",
          "LEASE",
          "LINUX_IMMUTABLE",
          "MAC_ADMIN",
          "MAC_OVERRIDE",
          "MKNOD",
          "NET_ADMIN",
          "NET_BIND_SERVICE",
          "NET_BROADCAST",
          "NET_RAW",
          "PERFMON",
          "SETFCAP",
          "SETGID",
          "SETPCAP",
          "SETUID",
          "SYS_ADMIN",
          "SYS_BOOT",
          "SYS_CHROOT",
          "SYS_MODULE",
          "SYS_NICE",
          "SYS_PACCT",
          "SYS_PTRACE",
          "SYS_RAWIO",
          "SYS_RESOURCE",
          "SYS_TIME",
          "SYS_TTY_CONFIG",
          "SYSLOG",
          "WAKE_ALARM"
        ]
      },
      "requiredDropCapabilities": {
        "type": "Array",
        "metadata": {
          "displayName": "Required drop capabilities",
          "description": "Select capability names from the supported Linux capability catalog, including ALL."
        },
        "defaultValue": [],
        "allowedValues": [
          "ALL",
          "AUDIT_CONTROL",
          "AUDIT_READ",
          "AUDIT_WRITE",
          "BLOCK_SUSPEND",
          "BPF",
          "CHECKPOINT_RESTORE",
          "CHOWN",
          "DAC_OVERRIDE",
          "DAC_READ_SEARCH",
          "FOWNER",
          "FSETID",
          "IPC_LOCK",
          "IPC_OWNER",
          "KILL",
          "LEASE",
          "LINUX_IMMUTABLE",
          "MAC_ADMIN",
          "MAC_OVERRIDE",
          "MKNOD",
          "NET_ADMIN",
          "NET_BIND_SERVICE",
          "NET_BROADCAST",
          "NET_RAW",
          "PERFMON",
          "SETFCAP",
          "SETGID",
          "SETPCAP",
          "SETUID",
          "SYS_ADMIN",
          "SYS_BOOT",
          "SYS_CHROOT",
          "SYS_MODULE",
          "SYS_NICE",
          "SYS_PACCT",
          "SYS_PTRACE",
          "SYS_RAWIO",
          "SYS_RESOURCE",
          "SYS_TIME",
          "SYS_TTY_CONFIG",
          "SYSLOG",
          "WAKE_ALARM"
        ]
      },
      "enabled": {
        "type": "String",
        "metadata": {
          "displayName": "Enable check throughout assignment scope",
          "description": "True checks every matching resource within the assignment scope; false skips the check. Use assignment exclusions or exemptions for exceptions. Select true or false; defaults to true."
        },
        "defaultValue": "true",
        "allowedValues": [
          "true",
          "false"
        ]
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "value": "[bool(parameters('enabled'))]",
            "equals": true
          },
          {
            "field": "type",
            "in": [
              "Microsoft.Kubernetes/connectedClusters",
              "Microsoft.ContainerService/managedClusters"
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "source": "[parameters('source')]",
          "warn": "[bool(parameters('warn'))]",
          "templateInfo": {
            "sourceType": "Base64Encoded",
            "content": ""
          },
          "apiGroups": [
            ""
          ],
          "kinds": [
            "Pod"
          ],
          "excludedNamespaces": [
            "kube-system",
            "gatekeeper-system",
            "azure-arc",
            "azure-extensions-usage-system"
          ],
          "namespaces": [],
          "labelSelector": {},
          "values": {
            "allowedCapabilities": "[parameters('allowedCapabilities')]",
            "requiredDropCapabilities": "[parameters('requiredDropCapabilities')]",
            "excludedContainers": [],
            "excludedImages": []
          }
        }
      }
    }
  }
}
