{
  "name": "landingzone-l23-l23-private-only-key-vault-networking",
  "properties": {
    "displayName": "Azure Key Vault should disable public network access",
    "description": "Audits selected Key Vaults unless publicNetworkAccess is explicitly Disabled, excluding recovery operations. No request API-version gate is used; approved private connectivity and DNS remain prerequisites.",
    "policyType": "Custom",
    "mode": "Indexed",
    "metadata": {
      "category": "Key Vault",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/Key%20Vault/PublicNetworkAccess_Audit.json",
      "sourcePolicyId": "/providers/Microsoft.Authorization/policyDefinitions/405c5871-3e91-4644-8a63-58e19d68ff5b",
      "catalogRow": "L23",
      "packageSet": "LandingZone"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Start in audit mode. Only effects supported by the source definition are available."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "evaluationScope": {
        "type": "Object",
        "metadata": {
          "displayName": "Explicit conditional resource applicability",
          "description": "Required applicability decision: includedResourceIdPatterns must contain at least one approved ARM resource-ID pattern; excludedResourceIdPatterns must be supplied and may be empty. Each pattern is exact or uses at most one '*' wildcard, following Policy like semantics. No resource IDs or default scope are assumed. Patterns filter resources already within the assignment scope and never expand that scope."
        },
        "schema": {
          "type": "object",
          "properties": {
            "includedResourceIdPatterns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^*]*(\\*[^*]*)?$"
              }
            },
            "excludedResourceIdPatterns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^*]*(\\*[^*]*)?$"
              }
            }
          },
          "required": [
            "includedResourceIdPatterns",
            "excludedResourceIdPatterns"
          ],
          "additionalProperties": false
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "count": {
              "value": "[parameters('evaluationScope').includedResourceIdPatterns]",
              "name": "evaluationScopeIncludedPattern",
              "where": {
                "field": "id",
                "like": "[current('evaluationScopeIncludedPattern')]"
              }
            },
            "greater": 0
          },
          {
            "count": {
              "value": "[parameters('evaluationScope').excludedResourceIdPatterns]",
              "name": "evaluationScopeExcludedPattern",
              "where": {
                "field": "id",
                "like": "[current('evaluationScopeExcludedPattern')]"
              }
            },
            "equals": 0
          },
          {
            "field": "type",
            "equals": "Microsoft.KeyVault/vaults"
          },
          {
            "field": "Microsoft.KeyVault/vaults/createMode",
            "notEquals": "recover"
          },
          {
            "field": "Microsoft.KeyVault/vaults/publicNetworkAccess",
            "notEquals": "Disabled"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
