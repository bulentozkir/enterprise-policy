{
  "name": "landingzone-l26-l26-private-only-postgresql-networking",
  "properties": {
    "displayName": "Public network access should be disabled for PostgreSQL flexible servers",
    "description": "Require disabled public network access or a complete VNet-integrated configuration when the public-access property is omitted. Explicitly enabled public access is always reported. This check does not provision private endpoints or verify private connectivity. Enabled=true checks all matching in-scope resources; false skips the check.",
    "policyType": "Custom",
    "mode": "Indexed",
    "metadata": {
      "category": "SQL",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/SQL/PostgreSQL_FlexibleServers_DisablePublicNetworkAccess_Audit.json",
      "sourcePolicyId": "/providers/Microsoft.Authorization/policyDefinitions/5e1de0e3-42cb-4ebc-a86d-61d0c619ca48",
      "catalogRow": "L26",
      "packageSet": "LandingZone"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "defaultValue": "Audit",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "Effect",
          "description": "Start in audit mode. Only effects supported by the source definition are available."
        }
      },
      "enabled": {
        "type": "String",
        "metadata": {
          "displayName": "Enable check throughout assignment scope",
          "description": "True checks every matching resource within the assignment scope; false skips the check. Use assignment exclusions or exemptions for exceptions. Select true or false; defaults to true."
        },
        "defaultValue": "true",
        "allowedValues": [
          "true",
          "false"
        ]
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "value": "[bool(parameters('enabled'))]",
            "equals": true
          },
          {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.DBforPostgreSQL/flexibleServers"
              },
              {
                "anyOf": [
                  {
                    "allOf": [
                      {
                        "field": "Microsoft.DBforPostgreSQL/flexibleServers/network.publicNetworkAccess",
                        "exists": "true"
                      },
                      {
                        "field": "Microsoft.DBforPostgreSQL/flexibleServers/network.publicNetworkAccess",
                        "notEquals": "Disabled"
                      }
                    ]
                  },
                  {
                    "allOf": [
                      {
                        "field": "Microsoft.DBforPostgreSQL/flexibleServers/network.publicNetworkAccess",
                        "exists": "false"
                      },
                      {
                        "anyOf": [
                          {
                            "field": "Microsoft.DBforPostgreSQL/flexibleServers/network.delegatedSubnetResourceId",
                            "exists": "false"
                          },
                          {
                            "field": "Microsoft.DBforPostgreSQL/flexibleServers/network.delegatedSubnetResourceId",
                            "equals": ""
                          },
                          {
                            "field": "Microsoft.DBforPostgreSQL/flexibleServers/network.privateDnsZoneArmResourceId",
                            "exists": "false"
                          },
                          {
                            "field": "Microsoft.DBforPostgreSQL/flexibleServers/network.privateDnsZoneArmResourceId",
                            "equals": ""
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
