{
  "name": "landingzone-l27-l27-private-application-backends",
  "properties": {
    "displayName": "App Service apps should disable public network access",
    "description": "Disabling public network access improves security by ensuring that the App Service is not exposed on the public internet. Creating private endpoints can limit exposure of an App Service. Learn more at: https://aka.ms/app-service-private-endpoint. Enabled=true checks all matching in-scope resources; false skips the check.",
    "policyType": "Custom",
    "mode": "Indexed",
    "metadata": {
      "category": "App Service",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/App%20Service/WebApp_PublicNetworkAccess_Audit.json",
      "sourcePolicyId": "/providers/Microsoft.Authorization/policyDefinitions/1b5ef780-c53c-4a64-87f3-bb9c8c8094ba",
      "catalogRow": "L27",
      "packageSet": "LandingZone"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Start in audit mode. Only effects supported by the source definition are available."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "enabled": {
        "type": "String",
        "metadata": {
          "displayName": "Enable check throughout assignment scope",
          "description": "True checks every matching resource within the assignment scope; false skips the check. Use assignment exclusions or exemptions for exceptions. Select true or false; defaults to true."
        },
        "defaultValue": "true",
        "allowedValues": [
          "true",
          "false"
        ]
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "value": "[bool(parameters('enabled'))]",
            "equals": true
          },
          {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.Web/sites"
              },
              {
                "field": "Microsoft.Web/sites/hostingEnvironmentProfile.id",
                "exists": "false"
              },
              {
                "anyOf": [
                  {
                    "field": "Microsoft.Web/sites/publicNetworkAccess",
                    "exists": "false"
                  },
                  {
                    "field": "Microsoft.Web/sites/publicNetworkAccess",
                    "notEquals": "Disabled"
                  }
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
