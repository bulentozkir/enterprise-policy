{
  "name": "landingzone-l33-l33-sql-microsoft-entra-administrator",
  "properties": {
    "displayName": "An Azure Active Directory administrator should be provisioned for SQL servers",
    "description": "Audit provisioning of an Azure Active Directory administrator for your SQL server to enable Azure AD authentication. Azure AD authentication enables simplified permission management and centralized identity management of database users and other Microsoft services",
    "policyType": "Custom",
    "mode": "Indexed",
    "metadata": {
      "category": "SQL",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/SQL/SQL_DB_AuditServerADAdmins_Audit.json",
      "sourcePolicyId": "/providers/Microsoft.Authorization/policyDefinitions/1f314764-cb73-4fc9-b863-8eca98ac36e9",
      "catalogRow": "L33",
      "packageSet": "LandingZone"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "Effect",
          "description": "Start in audit mode. Only effects supported by the source definition are available."
        }
      },
      "evaluationScope": {
        "type": "Object",
        "metadata": {
          "displayName": "Explicit conditional resource applicability",
          "description": "Required applicability decision: includedResourceIdPatterns must contain at least one approved ARM resource-ID pattern; excludedResourceIdPatterns must be supplied and may be empty. Each pattern is exact or uses at most one '*' wildcard, following Policy like semantics. No resource IDs or default scope are assumed. Patterns filter resources already within the assignment scope and never expand that scope."
        },
        "schema": {
          "type": "object",
          "properties": {
            "includedResourceIdPatterns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^*]*(\\*[^*]*)?$"
              }
            },
            "excludedResourceIdPatterns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^*]*(\\*[^*]*)?$"
              }
            }
          },
          "required": [
            "includedResourceIdPatterns",
            "excludedResourceIdPatterns"
          ],
          "additionalProperties": false
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "count": {
              "value": "[parameters('evaluationScope').includedResourceIdPatterns]",
              "name": "evaluationScopeIncludedPattern",
              "where": {
                "field": "id",
                "like": "[current('evaluationScopeIncludedPattern')]"
              }
            },
            "greater": 0
          },
          {
            "count": {
              "value": "[parameters('evaluationScope').excludedResourceIdPatterns]",
              "name": "evaluationScopeExcludedPattern",
              "where": {
                "field": "id",
                "like": "[current('evaluationScopeExcludedPattern')]"
              }
            },
            "equals": 0
          },
          {
            "field": "type",
            "equals": "Microsoft.Sql/servers"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.Sql/servers/administrators"
        }
      }
    }
  }
}
