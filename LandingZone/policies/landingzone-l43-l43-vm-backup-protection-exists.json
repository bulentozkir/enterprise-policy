{
  "name": "landingzone-l43-l43-vm-backup-protection-exists",
  "properties": {
    "displayName": "Azure Backup should be enabled for Virtual Machines",
    "description": "Ensure protection of your Azure Virtual Machines by enabling Azure Backup. Azure Backup is a secure and cost effective data protection solution for Azure. Enabled=true checks all matching in-scope resources; false skips the check.",
    "policyType": "Custom",
    "mode": "Indexed",
    "metadata": {
      "category": "Backup",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/Backup/VirtualMachines_EnableAzureBackup_Audit.json",
      "sourcePolicyId": "/providers/Microsoft.Authorization/policyDefinitions/013e242c-8828-4970-87b3-ab247555486d",
      "catalogRow": "L43",
      "packageSet": "LandingZone"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "Effect",
          "description": "Start in audit mode. Only effects supported by the source definition are available."
        }
      },
      "enabled": {
        "type": "String",
        "metadata": {
          "displayName": "Enable check throughout assignment scope",
          "description": "True checks every matching resource within the assignment scope; false skips the check. Use assignment exclusions or exemptions for exceptions. Select true or false; defaults to true."
        },
        "defaultValue": "true",
        "allowedValues": [
          "true",
          "false"
        ]
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "value": "[bool(parameters('enabled'))]",
            "equals": true
          },
          {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.Compute/virtualMachines"
              },
              {
                "field": "id",
                "notContains": "/resourceGroups/databricks-rg-"
              },
              {
                "field": "Microsoft.Compute/imagePublisher",
                "notEquals": "azureopenshift"
              },
              {
                "field": "Microsoft.Compute/imagePublisher",
                "notEquals": "AzureDatabricks"
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.RecoveryServices/backupprotecteditems"
        }
      }
    }
  }
}
