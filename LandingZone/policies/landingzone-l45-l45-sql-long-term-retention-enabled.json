{
  "name": "landingzone-l45-l45-sql-long-term-retention-enabled",
  "properties": {
    "displayName": "Long-term geo-redundant backup should be enabled for Azure SQL Databases",
    "description": "This policy audits any Azure SQL Database with long-term geo-redundant backup not enabled.",
    "policyType": "Custom",
    "mode": "Indexed",
    "metadata": {
      "category": "SQL",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/SQL/GeoRedundant_SQLDatabase_AINE.json",
      "sourcePolicyId": "/providers/Microsoft.Authorization/policyDefinitions/d38fc420-0735-4ef3-ac11-c806f651a570",
      "catalogRow": "L45",
      "packageSet": "LandingZone"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "Effect",
          "description": "Start in audit mode. Only effects supported by the source definition are available."
        }
      },
      "evaluationScope": {
        "type": "Object",
        "metadata": {
          "displayName": "Explicit conditional resource applicability",
          "description": "Required applicability decision: includedResourceIdPatterns must contain at least one approved ARM resource-ID pattern; excludedResourceIdPatterns must be supplied and may be empty. Each pattern is exact or uses at most one '*' wildcard, following Policy like semantics. No resource IDs or default scope are assumed. Patterns filter resources already within the assignment scope and never expand that scope."
        },
        "schema": {
          "type": "object",
          "properties": {
            "includedResourceIdPatterns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^*]*(\\*[^*]*)?$"
              }
            },
            "excludedResourceIdPatterns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^*]*(\\*[^*]*)?$"
              }
            }
          },
          "required": [
            "includedResourceIdPatterns",
            "excludedResourceIdPatterns"
          ],
          "additionalProperties": false
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "count": {
              "value": "[parameters('evaluationScope').includedResourceIdPatterns]",
              "name": "evaluationScopeIncludedPattern",
              "where": {
                "field": "id",
                "like": "[current('evaluationScopeIncludedPattern')]"
              }
            },
            "greater": 0
          },
          {
            "count": {
              "value": "[parameters('evaluationScope').excludedResourceIdPatterns]",
              "name": "evaluationScopeExcludedPattern",
              "where": {
                "field": "id",
                "like": "[current('evaluationScopeExcludedPattern')]"
              }
            },
            "equals": 0
          },
          {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.Sql/servers/databases"
              },
              {
                "field": "name",
                "notEquals": "master"
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.Sql/servers/databases/backupLongTermRetentionPolicies",
          "name": "default",
          "existenceCondition": {
            "anyOf": [
              {
                "field": "Microsoft.Sql/servers/databases/backupLongTermRetentionPolicies/weeklyRetention",
                "notEquals": "PT0S"
              },
              {
                "field": "Microsoft.Sql/servers/databases/backupLongTermRetentionPolicies/monthlyRetention",
                "notEquals": "PT0S"
              },
              {
                "field": "Microsoft.Sql/servers/databases/backupLongTermRetentionPolicies/yearlyRetention",
                "notEquals": "PT0S"
              }
            ]
          }
        }
      }
    }
  }
}
