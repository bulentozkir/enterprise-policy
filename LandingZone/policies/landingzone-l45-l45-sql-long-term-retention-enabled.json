{
  "name": "landingzone-l45-l45-sql-long-term-retention-enabled",
  "properties": {
    "displayName": "Long-term retention should be enabled for Azure SQL Databases",
    "description": "Audit Azure SQL databases without a present, nonempty, nonzero weekly, monthly or yearly long-term retention duration. This check does not verify backup storage redundancy. Enabled=true checks all matching in-scope resources; false skips the check.",
    "policyType": "Custom",
    "mode": "Indexed",
    "metadata": {
      "category": "SQL",
      "source": "https://raw.githubusercontent.com/Azure/azure-policy/master/built-in-policies/policyDefinitions/SQL/GeoRedundant_SQLDatabase_AINE.json",
      "sourcePolicyId": "/providers/Microsoft.Authorization/policyDefinitions/d38fc420-0735-4ef3-ac11-c806f651a570",
      "catalogRow": "L45",
      "packageSet": "LandingZone"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "defaultValue": "AuditIfNotExists",
        "allowedValues": [
          "AuditIfNotExists",
          "Disabled"
        ],
        "metadata": {
          "displayName": "Effect",
          "description": "Start in audit mode. Only effects supported by the source definition are available."
        }
      },
      "enabled": {
        "type": "String",
        "metadata": {
          "displayName": "Enable check throughout assignment scope",
          "description": "True checks every matching resource within the assignment scope; false skips the check. Use assignment exclusions or exemptions for exceptions. Select true or false; defaults to true."
        },
        "defaultValue": "true",
        "allowedValues": [
          "true",
          "false"
        ]
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "value": "[bool(parameters('enabled'))]",
            "equals": true
          },
          {
            "allOf": [
              {
                "field": "type",
                "equals": "Microsoft.Sql/servers/databases"
              },
              {
                "field": "name",
                "notEquals": "master"
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.Sql/servers/databases/backupLongTermRetentionPolicies",
          "name": "default",
          "existenceCondition": {
            "anyOf": [
              {
                "allOf": [
                  {
                    "field": "Microsoft.Sql/servers/databases/backupLongTermRetentionPolicies/weeklyRetention",
                    "exists": "true"
                  },
                  {
                    "field": "Microsoft.Sql/servers/databases/backupLongTermRetentionPolicies/weeklyRetention",
                    "notIn": [
                      "",
                      "PT0S",
                      "P0W",
                      "P0M",
                      "P0Y",
                      "P0D"
                    ]
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "Microsoft.Sql/servers/databases/backupLongTermRetentionPolicies/monthlyRetention",
                    "exists": "true"
                  },
                  {
                    "field": "Microsoft.Sql/servers/databases/backupLongTermRetentionPolicies/monthlyRetention",
                    "notIn": [
                      "",
                      "PT0S",
                      "P0W",
                      "P0M",
                      "P0Y",
                      "P0D"
                    ]
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "field": "Microsoft.Sql/servers/databases/backupLongTermRetentionPolicies/yearlyRetention",
                    "exists": "true"
                  },
                  {
                    "field": "Microsoft.Sql/servers/databases/backupLongTermRetentionPolicies/yearlyRetention",
                    "notIn": [
                      "",
                      "PT0S",
                      "P0W",
                      "P0M",
                      "P0Y",
                      "P0D"
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    }
  }
}
